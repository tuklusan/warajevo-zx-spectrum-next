@ECHO OFF

REM Ovdje staviti definicije vlastitih programa

SET EDT=\utility\q
SET ASM=\JEZICI\MASM\TASM /a
SET LNK=\JEZICI\MASM\TLINK /n /P /x

CALL SETEXE

:LOOP
SELECT /CURSOFF
CLS
MODE CO80
ECHO ZX SPECTRUM 48K/128K SIMULATOR
ECHO:
ECHO:   Edit SPECSIM.ASM
ECHO:   Edit Z80.ASM
ECHO:   Edit TAPE.ASM
ECHO:   Edit SPECMON.ASM
ECHO:   Edit ZXPRINT.ASM
ECHO:   Edit MDRIVE.ASM
ECHO:   Change version
ECHO:   Set configuration file
ECHO:   Assemble and link
ECHO:   Run program
ECHO:   DOS shell
ECHO:   Quit
SELECT 3 14 "->"
IF ERRORLEVEL 12 GOTO END
IF ERRORLEVEL 11 GOTO DSHELL
IF ERRORLEVEL 10 GOTO RUN
IF ERRORLEVEL 9 GOTO ASMLINK
IF ERRORLEVEL 8 GOTO SETCFG
IF ERRORLEVEL 7 GOTO CHGVER
IF ERRORLEVEL 6 GOTO EDMDV
IF ERRORLEVEL 5 GOTO EDPRINT
IF ERRORLEVEL 4 GOTO EDMON
IF ERRORLEVEL 3 GOTO EDTAPE
IF ERRORLEVEL 2 GOTO EDZ80
CLS
SET OP=3
IF EXIST SPECSIM.OBJ DEL SPECSIM.OBJ
edit SPECSIM.ASM
SET STARTPOS=11
GOTO LOOP
:EDZ80
SET OP=4
IF EXIST Z80.OBJ DEL Z80.OBJ
%EDT% Z80.ASM
SET STARTPOS=11
GOTO LOOP
:EDTAPE
SET OP=5
IF EXIST TAPE.OBJ DEL TAPE.OBJ
%EDT% TAPE.ASM
SET STARTPOS=11
GOTO LOOP
:EDMON
SET OP=6
IF EXIST SPECMON.OBJ DEL SPECMON.OBJ
%EDT% SPECMON.ASM
SET STARTPOS=11
GOTO LOOP
:EDPRINT
SET OP=7
IF EXIST ZXPRINT.OBJ DEL ZXPRINT.OBJ
%EDT% ZXPRINT.ASM
SET STARTPOS=11
GOTO LOOP
:EDMDV
SET OP=8
IF EXIST MDRIVE.OBJ DEL MDRIVE.OBJ
%EDT% MDRIVE.ASM
SET STARTPOS=11
GOTO LOOP
:SETCFG
SET STARTPOS=12
SET OP=3
%EDT% SPECSIM.CFG
GOTO LOOP
:CHGVER
SET OP=3
IF EXIST SPECSIM.OBJ DEL SPECSIM.OBJ
IF EXIST Z80.OBJ DEL Z80.OBJ
IF EXIST TAPE.OBJ DEL TAPE.OBJ
IF EXIST SPECMON.OBJ DEL SPECMON.OBJ
ECHO:
ECHO:
ECHO:
ECHO:
ECHO:
ECHO:
ECHO:
ECHO SELECT VERSION:
ECHO:
ECHO:   Version ZX Spectrum 48K
ECHO:   Version ZX Spectrum 128K
SET STARTPOS=18
SELECT 18 19 "->"
IF ERRORLEVEL 2 GOTO VER128
ECHO VER_128    equ 0 >VERSION.ASM
ECHO SET EXE=SPEC48.EXE >SETEXE.BAT
SET EXE=SPEC48.EXE
SET STARTPOS=11
GOTO LOOP
:VER128
ECHO VER_128    equ 1 >VERSION.ASM
ECHO SET EXE=SPEC128.EXE >SETEXE.BAT
SET EXE=SPEC128.EXE
SET STARTPOS=11
GOTO LOOP
:ASMLINK
CLS
IF EXIST %EXE% DEL %EXE%
IF EXIST SPECSIM.OBJ GOTO ASM1
%ASM% SPECSIM;
IF ERRORLEVEL 1 GOTO ASMERR
:ASM1
IF EXIST SPECLOGO.OBJ GOTO ASM2
%ASM% SPECLOGO;
IF ERRORLEVEL 1 GOTO ASMERR
:ASM2
IF EXIST ZXPRINT.OBJ GOTO ASM3
%ASM% ZXPRINT;
IF ERRORLEVEL 1 GOTO ASMERR
:ASM3
IF EXIST TAPE.OBJ GOTO ASM4
%ASM% TAPE;
IF ERRORLEVEL 1 GOTO ASMERR
:ASM4
IF EXIST SPECMON.OBJ GOTO ASM5
%ASM% SPECMON;
IF ERRORLEVEL 1 GOTO ASMERR
:ASM5
IF EXIST Z80.OBJ GOTO ASM6
rem %ASM% Z80;
\jezici\masm\masm z80;
echo:
IF ERRORLEVEL 1 GOTO ASMERR
:ASM6
IF EXIST MDRIVE.OBJ GOTO ASM7
%ASM% MDRIVE;
IF ERRORLEVEL 1 GOTO ASMERR
:ASM7
\JEZICI\MASM\TLINK /n /P /x SPECSIM+Z80+SPECLOGO+ZXPRINT+TAPE+MDRIVE+SPECMON;
RENAME SPECSIM.EXE %EXE%
IF ERRORLEVEL 1 GOTO ASMERR
SET STARTPOS=12
GOTO LOOP
:ASMERR
SET STARTPOS=%OP%
PAUSE
GOTO LOOP
:RUN
CLS
%EXE% /C
SET STARTPOS=%OP%
ECHO:
PAUSE

MODE MONO

GOTO LOOP
:DSHELL
CLS
SELECT /CURSON
PROMPT DOS shell$_$P$G
COMMAND
PROMPT $P$G
GOTO LOOP
:END
CLS
:PS
SET STARTPOS=
SET OP=
SET EDT=
SET ASM=
SET LNK=
SELECT /CURSON
