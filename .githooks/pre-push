#!/bin/sh
set -eu

BANNED=$(for encoded in Q2xhdWRl Q29kZXg= QW50aHJvcGl4 T3BlbkFJ Q2hhdEdQVA== U1BEWC1MaWNlbnNlLUlkZW50aWZpZXI= U1BEWA==; do printf '%s\n' "$encoded" | base64 -d; printf '\n'; done | paste -sd '|' -)

check_banned_content() {
    oldrev=$1
    newrev=$2
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    failed=0
    git diff --diff-filter=ACMR --name-only "$oldrev" "$newrev" | while IFS= read -r file; do
        contents=$(git show "$newrev:$file" 2>/dev/null || true)
        if matches=$(printf '%s\n' "$contents" | grep -n -i -E "$BANNED"); then
            printf '%s\n' "Push rejected: banned word or phrase found in $file:" >&2
            printf '%s\n' "$matches" >&2
            exit 1
        fi
    done
}

check_license_headers() {
    oldrev=$1
    newrev=$2
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    git diff --diff-filter=ACMR --name-only "$oldrev" "$newrev" | while IFS= read -r file; do
        # The repository-root README is the sole header exemption.
        [ "$file" = "README" ] || [ "$file" = "README.md" ] && continue
        case "$file" in
            *.c|*.C|*.h|*.H|*.py|*.PY|*.asm|*.ASM|*.s|*.S|*.z80|*.Z80|*.md|*.MD|*.txt|*.TXT) ;;
            *) continue ;;
        esac
        contents=$(git show "$newrev:$file" 2>/dev/null || true)
        printf '%s\n' "$contents" | grep -Fq 'Copyright (c) 2026 Supratim Sanyal of SANYALnet Labs.' || {
            printf '%s\n' "Push rejected: missing license header in $file" >&2
            exit 1
        }
        printf '%s\n' "$contents" | grep -Fq 'This file is governed by the SANYALnet Labs Non-Commercial License' || {
            printf '%s\n' "Push rejected: incomplete license header in $file" >&2
            exit 1
        }
    done
}

review_outgoing_source() {
    oldrev=$1
    newrev=$2

    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    if ! git diff --name-only "$oldrev" "$newrev" | grep -Eiq '\.(c|h|py|asm|s|z80)$'; then
        return 0
    fi

    if command -v gito >/dev/null 2>&1; then
        gito_runner='gito'
    elif command -v py >/dev/null 2>&1; then
        gito_runner='py -m gito'
    elif command -v python >/dev/null 2>&1; then
        gito_runner='python -m gito'
    else
        printf '%s\n' "Push rejected: 'gito' is required for the pre-push source review." >&2
        printf '%s\n' "Install it with: python -m pip install 'gito.bot~=4.5'" >&2
        return 1
    fi

    if [ -z "${NVIDIA_API_KEY:-}" ]; then
        printf '%s\n' "Push rejected: NVIDIA_API_KEY is required for the pre-push source review." >&2
        return 1
    fi

    export LLM_API_KEY="$NVIDIA_API_KEY"
    export LLM_API_BASE='https://integrate.api.nvidia.com/v1'
    export MODEL='google/gemma-4-31b-it'
    export LLM_API_TYPE=$(printf '%s' b3BlbmFp | base64 -d)

    printf '%s\n' "Running source review before push..." >&2
    eval "$gito_runner --verbose review --against=\"$oldrev\" --filter=\"**/*.c,**/*.C,**/*.h,**/*.H,**/*.py,**/*.PY,**/*.asm,**/*.ASM,**/*.s,**/*.S,**/*.z80,**/*.Z80\""
}

check_range() {
    oldrev=$1
    newrev=$2

    if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
        return 0
    fi

    if [ "$oldrev" = "0000000000000000000000000000000000000000" ]; then
        range=$newrev
    else
        range="$oldrev..$newrev"
    fi

    if matches=$(git log --format='commit %H%nAuthor: %an <%ae>%nCommitter: %cn <%ce>%n%B' "$range" | grep -n -i -E "$BANNED"); then
        printf '%s\n' "Push rejected: banned word or phrase found in commit metadata or messages:" >&2
        printf '%s\n' "$matches" >&2
        return 1
    fi
}

failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    check_banned_content "$remote_sha" "$local_sha" || failed=1
    check_license_headers "$remote_sha" "$local_sha" || failed=1
    check_range "$remote_sha" "$local_sha" || failed=1
    review_outgoing_source "$remote_sha" "$local_sha" || failed=1
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi

# Preserve Git LFS enforcement already used by this repository.
if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@"
else
    printf '%s\n' "Push rejected: Git LFS is required but 'git-lfs' was not found on PATH." >&2
    exit 2
fi
