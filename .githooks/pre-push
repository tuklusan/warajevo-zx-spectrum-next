#!/usr/bin/env bash
set -eu

BANNED=$(for encoded in Q2xhdWRl Q29kZXg= QW50aHJvcGl4 T3BlbkFJ Q2hhdEdQVA== U1BEWC1MaWNlbnNlLUlkZW50aWZpZXI= U1BEWA==; do printf '%s\n' "$encoded" | base64 -d; printf '\n'; done | paste -sd '|' -)

check_pathnames() {
    newrev=$1
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0

    if command -v python3 >/dev/null 2>&1; then
        python3 ci/validate-pathnames.py "$newrev"
    elif command -v py >/dev/null 2>&1; then
        py -3 ci/validate-pathnames.py "$newrev"
    elif command -v python >/dev/null 2>&1; then
        python ci/validate-pathnames.py "$newrev"
    else
        printf '%s\n' "Push rejected: Python is required to validate repository pathnames." >&2
        return 1
    fi
}

check_banned_commit_content() {
    commit=$1
    while IFS= read -r -d '' file; do
        contents=$(git show "$commit:$file" 2>/dev/null || true)
        if matches=$(printf '%s\n' "$contents" | grep -n -i -E "$BANNED"); then
            printf '%s\n' "Push rejected: banned word or phrase found in commit $commit, file $file:" >&2
            printf '%s\n' "$matches" >&2
            return 1
        fi
    done < <(git diff-tree --root -r -M --no-commit-id --name-only -z "$commit")
}

check_pushed_history() {
    oldrev=$1
    newrev=$2
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    if [ "$oldrev" = "0000000000000000000000000000000000000000" ]; then
        range=$newrev
    else
        range="$oldrev..$newrev"
    fi
    while IFS= read -r commit; do
        [ -n "$commit" ] || continue
        check_pathnames "$commit" >/dev/null || return 1
        check_banned_commit_content "$commit" || return 1
    done < <(git rev-list --reverse "$range")
}

check_license_headers() {
    oldrev=$1
    newrev=$2
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    changed=$(git diff --diff-filter=ACMR --name-only "$oldrev" "$newrev" |
        grep -Ei '\.(c|h|py|asm|s|z80|md|txt)$' |
        grep -Ev '^(README|README\.md)$' || true)
    [ -n "$changed" ] || return 0

    missing=$(printf '%s\n' "$changed" |
        git grep -L \
            -e 'New original material is licensed under GNU GPL v2 or later' \
            -e 'This file is licensed under the GNU General Public License, version 2 or later.' \
            -e 'This file is governed by the SANYALnet Labs Non-Commercial License' \
            "$newrev" -- $(printf '%s\n' "$changed") 2>/dev/null || true)
    if [ -n "$missing" ]; then
        printf '%s\n' "Push rejected: missing or incomplete license header." >&2
        return 1
    fi
}

review_finish_batch() {
    for ((packet = 0; packet < review_count; packet++)); do
        packet_status=0
        wait "${review_pids[$packet]}" || packet_status=$?
        review_log=${review_logs[$packet]}
        cat "$review_log" >&2
        if [ "$packet_status" -eq 0 ] &&
           grep -Fq 'PROCESSING WARNINGS' "$review_log"; then
            printf '%s\n' "Push rejected: source review skipped one or more files." >&2
            packet_status=1
        fi
        if [ "$packet_status" -ne 0 ] && [ "$review_status" -eq 0 ]; then
            review_status=$packet_status
            review_failed_log=$review_log
        fi
    done
    review_pids=()
    review_logs=()
    review_count=0
}

review_outgoing_source() {
    oldrev=$1
    newrev=$2

    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    if ! git diff --name-only "$oldrev" "$newrev" | grep -Eiq '\.(c|h|py|asm|s|z80)$'; then
        return 0
    fi

    # Header-only license migrations do not alter executable source and do not
    # need an LLM review packet. Any other source diff remains mandatory.
    if ! git diff --ignore-space-at-eol --ignore-blank-lines --unified=0 "$oldrev" "$newrev" -- \
        '*.c' '*.h' '*.py' '*.asm' '*.s' '*.z80' |
        awk '
            /^\+\+\+|^---/ { next }
            /^[+-]/ {
                line = substr($0, 2)
                if (line ~ /This file is governed by the SANYALnet Labs Non-Commercial License/ ||
                    line ~ /root LICENSE file\. Non-Commercial use is permitted/ ||
                    line ~ /for AI\/ML model training are prohibited/ ||
                    line ~ /New original material is licensed under GNU GPL v2 or later/ ||
                    line ~ /See LICENSE and NOTICE\\.md for complete terms and provenance\\./ ||
                    line ~ /root LICENSE file\\. Commercial Use and use for AI\/ML model training are/ ||
                    line ~ /prohibited unless separately authorized\\. Attribution is required\\. See/ ||
                    line ~ /This file is licensed under the GNU General Public License, version 2 or later\./ ||
                    line ~ /Proprietary rights reserved except as expressly licensed herein\./ ||
                    line ~ /LICENSE\.txt/) next
                found = 1
                exit
            }
            END { exit(found ? 0 : 1) }
        '; then
        return 0
    fi

    if command -v gito >/dev/null 2>&1; then
        gito_runner='gito'
    elif command -v py >/dev/null 2>&1; then
        gito_runner='py -m gito'
    elif command -v python >/dev/null 2>&1; then
        gito_runner='python -m gito'
    else
        printf '%s\n' "Push rejected: 'gito' is required for the pre-push source review." >&2
        printf '%s\n' "Install it with: python -m pip install 'gito.bot~=4.5'" >&2
        return 1
    fi

    if [ -z "${NVIDIA_API_KEY:-}" ]; then
        printf '%s\n' "Push rejected: NVIDIA_API_KEY is required for the pre-push source review." >&2
        return 1
    fi

    if command -v timeout >/dev/null 2>&1; then
        review_timeout=timeout
    elif command -v gtimeout >/dev/null 2>&1; then
        review_timeout=gtimeout
    else
        printf '%s\n' "Push rejected: GNU timeout is required to enforce the 20-minute source-review limit." >&2
        return 1
    fi

    export LLM_API_KEY="$NVIDIA_API_KEY"
    export LLM_API_BASE='https://integrate.api.nvidia.com/v1'
    export MODEL='google/gemma-4-31b-it'
    export LLM_API_TYPE=$(printf '%s' b3BlbmFp | base64 -d)
    export LLM_DEFAULT_ARGS='{"temperature":0,"max_tokens":512}'

    review_lock=$(git rev-parse --git-path wzsn-source-review.lock)
    if ! mkdir "$review_lock" 2>/dev/null; then
        review_owner=$(cat "$review_lock/pid" 2>/dev/null || true)
        if [ -n "$review_owner" ] && kill -0 "$review_owner" 2>/dev/null; then
            printf '%s\n' "Push rejected: another project source review is already active." >&2
            printf '%s\n' "Wait for it to finish before starting another push." >&2
            return 1
        fi
        rm -f "$review_lock/pid"
        rmdir "$review_lock" 2>/dev/null || true
        mkdir "$review_lock" 2>/dev/null || {
            printf '%s\n' "Push rejected: could not acquire the project source review lock." >&2
            return 1
        }
    fi
    printf '%s\n' "$$" > "$review_lock/pid"
    trap 'rm -f "$review_lock/pid"; rmdir "$review_lock" 2>/dev/null || true' EXIT

    printf '%s\n' "Running source review before push, one file per packet..." >&2
    review_status=0
    review_started=$(date +%s)
    review_index=0
    review_count=0
    review_root="$(git rev-parse --show-toplevel)/scratch/temp/source-reviews-$newrev"
    mkdir -p "$review_root"
    review_pids=()
    review_logs=()
    review_failed_log=
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        review_index=$((review_index + 1))
        review_elapsed=$(($(date +%s) - review_started))
        review_remaining=$((1200 - review_elapsed))
        if [ "$review_remaining" -le 0 ]; then
            review_status=124
            review_failed_log=$review_root
            break
        fi

        review_log="$review_root/$review_index.log"
        review_output="$review_root/$review_index"
        mkdir -p "$review_output"
        printf 'Reviewing %s (packet %s)...\n' "$file" "$review_index" >&2
        if [ "$gito_runner" = "gito" ]; then
            "$review_timeout" --signal=TERM --kill-after=10s "${review_remaining}s" \
                gito --verbose review --against="$oldrev" --filter="$file" --out="$review_output" \
                >"$review_log" 2>&1 &
        elif [ "$gito_runner" = "py -m gito" ]; then
            "$review_timeout" --signal=TERM --kill-after=10s "${review_remaining}s" \
                py -m gito --verbose review --against="$oldrev" --filter="$file" --out="$review_output" \
                >"$review_log" 2>&1 &
        else
            "$review_timeout" --signal=TERM --kill-after=10s "${review_remaining}s" \
                python -m gito --verbose review --against="$oldrev" --filter="$file" --out="$review_output" \
                >"$review_log" 2>&1 &
        fi
        review_pids[$review_count]=$!
        review_logs[$review_count]=$review_log
        review_count=$((review_count + 1))
        # Keep each packet isolated.  Concurrent model requests make the
        # mandatory review gate race the provider and can turn a valid review
        # into a false 20-minute stall.
        if [ "$review_count" -eq 1 ]; then
            review_finish_batch
            [ "$review_status" -eq 0 ] || break
        fi
    done < <(git diff --name-only "$oldrev" "$newrev" | grep -Ei '\.(c|h|py|asm|s|z80)$')
    if [ "$review_count" -gt 0 ]; then
        review_finish_batch
    fi

    review_elapsed=$(($(date +%s) - review_started))
    if [ "$review_status" -eq 124 ] && [ "$review_elapsed" -ge 1200 ]; then
        stall_log="$(git rev-parse --show-toplevel)/scratch/temp/source-review-stall.log"
        printf 'STALL elapsed=%ss limit=1200s diagnostics=%s\n' \
            "$review_elapsed" "${review_failed_log:-$review_root}" | tee -a "$stall_log" >&2
    fi
    rm -f "$review_lock/pid"
    rmdir "$review_lock" 2>/dev/null || true
    trap - EXIT
    return "$review_status"
}

check_range() {
    oldrev=$1
    newrev=$2

    if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
        return 0
    fi

    if [ "$oldrev" = "0000000000000000000000000000000000000000" ]; then
        range=$newrev
    else
        range="$oldrev..$newrev"
    fi

    if matches=$(git log --format='commit %H%nAuthor: %an <%ae>%nCommitter: %cn <%ce>%n%B' "$range" | grep -n -i -E "$BANNED"); then
        printf '%s\n' "Push rejected: banned word or phrase found in commit metadata or messages:" >&2
        printf '%s\n' "$matches" >&2
        return 1
    fi
}

push_input=$(cat)
failed=0
bash .githooks/validate-test-ledger.sh || failed=1
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    if [ "$local_ref" != "refs/heads/main" ] || [ "$remote_ref" != "refs/heads/main" ]; then
        printf '%s\n' "Push rejected: this project accepts direct branch pushes to main only." >&2
        failed=1
    fi
    check_pushed_history "$remote_sha" "$local_sha" || failed=1
    check_license_headers "$remote_sha" "$local_sha" || failed=1
    check_range "$remote_sha" "$local_sha" || failed=1
    if [ "$failed" -eq 0 ]; then
        review_outgoing_source "$remote_sha" "$local_sha" || failed=1
    fi
done <<EOF
$push_input
EOF

if [ "$failed" -ne 0 ]; then
    exit 1
fi

# Preserve Git LFS enforcement already used by this repository.
if git lfs version >/dev/null 2>&1; then
    [ -n "$push_input" ] && printf '%s\n' "$push_input" | git lfs pre-push "$@"
else
    printf '%s\n' "Push rejected: Git LFS is required but 'git-lfs' was not found on PATH." >&2
    exit 2
fi
