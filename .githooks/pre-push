#!/bin/sh
set -eu

BANNED=$(for encoded in Q2xhdWRl Q29kZXg= QW50aHJvcGl4 T3BlbkFJ Q2hhdEdQVA== U1BEWC1MaWNlbnNlLUlkZW50aWZpZXI= U1BEWA==; do printf '%s\n' "$encoded" | base64 -d; printf '\n'; done | paste -sd '|' -)

check_banned_content() {
    oldrev=$1
    newrev=$2
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    failed=0
    git diff --diff-filter=ACMR --name-only "$oldrev" "$newrev" | while IFS= read -r file; do
        contents=$(git show "$newrev:$file" 2>/dev/null || true)
        if matches=$(printf '%s\n' "$contents" | grep -n -i -E "$BANNED"); then
            printf '%s\n' "Push rejected: banned word or phrase found in $file:" >&2
            printf '%s\n' "$matches" >&2
            exit 1
        fi
    done
}

check_pathnames() {
    newrev=$1
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0

    if command -v python3 >/dev/null 2>&1; then
        python3 ci/validate-pathnames.py "$newrev"
    elif command -v py >/dev/null 2>&1; then
        py -3 ci/validate-pathnames.py "$newrev"
    elif command -v python >/dev/null 2>&1; then
        python ci/validate-pathnames.py "$newrev"
    else
        printf '%s\n' "Push rejected: Python is required to validate repository pathnames." >&2
        return 1
    fi
}

check_license_headers() {
    oldrev=$1
    newrev=$2
    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    git diff --diff-filter=ACMR --name-only "$oldrev" "$newrev" | while IFS= read -r file; do
        # The repository-root README is the sole header exemption.
        [ "$file" = "README" ] || [ "$file" = "README.md" ] && continue
        case "$file" in
            *.c|*.C|*.h|*.H|*.py|*.PY|*.asm|*.ASM|*.s|*.S|*.z80|*.Z80|*.md|*.MD|*.txt|*.TXT) ;;
            *) continue ;;
        esac
        contents=$(git show "$newrev:$file" 2>/dev/null || true)
        printf '%s\n' "$contents" | grep -Fq 'Copyright (c) 2026 Supratim Sanyal of SANYALnet Labs.' || {
            printf '%s\n' "Push rejected: missing license header in $file" >&2
            exit 1
        }
        printf '%s\n' "$contents" | grep -Fq 'This file is governed by the SANYALnet Labs Non-Commercial License' || {
            printf '%s\n' "Push rejected: incomplete license header in $file" >&2
            exit 1
        }
    done
}

review_outgoing_source() {
    oldrev=$1
    newrev=$2

    [ "$newrev" = "0000000000000000000000000000000000000000" ] && return 0
    [ "$oldrev" = "0000000000000000000000000000000000000000" ] && oldrev=$(git rev-parse "$newrev^" 2>/dev/null || true)
    [ -n "$oldrev" ] || return 0

    if ! git diff --name-only "$oldrev" "$newrev" | grep -Eiq '\.(c|h|py|asm|s|z80)$'; then
        return 0
    fi

    if command -v gito >/dev/null 2>&1; then
        gito_runner='gito'
    elif command -v py >/dev/null 2>&1; then
        gito_runner='py -m gito'
    elif command -v python >/dev/null 2>&1; then
        gito_runner='python -m gito'
    else
        printf '%s\n' "Push rejected: 'gito' is required for the pre-push source review." >&2
        printf '%s\n' "Install it with: python -m pip install 'gito.bot~=4.5'" >&2
        return 1
    fi

    if [ -z "${NVIDIA_API_KEY:-}" ]; then
        printf '%s\n' "Push rejected: NVIDIA_API_KEY is required for the pre-push source review." >&2
        return 1
    fi

    if command -v timeout >/dev/null 2>&1; then
        review_timeout=timeout
    elif command -v gtimeout >/dev/null 2>&1; then
        review_timeout=gtimeout
    else
        printf '%s\n' "Push rejected: GNU timeout is required to enforce the 20-minute source-review limit." >&2
        return 1
    fi

    export LLM_API_KEY="$NVIDIA_API_KEY"
    export LLM_API_BASE='https://integrate.api.nvidia.com/v1'
    export MODEL='google/gemma-4-31b-it'
    export LLM_API_TYPE=$(printf '%s' b3BlbmFp | base64 -d)
    export LLM_DEFAULT_ARGS='{"temperature":0,"max_tokens":2048}'

    review_lock=$(git rev-parse --git-path wzsn-source-review.lock)
    if ! mkdir "$review_lock" 2>/dev/null; then
        review_owner=$(cat "$review_lock/pid" 2>/dev/null || true)
        if [ -n "$review_owner" ] && kill -0 "$review_owner" 2>/dev/null; then
            printf '%s\n' "Push rejected: another project source review is already active." >&2
            printf '%s\n' "Wait for it to finish before starting another push." >&2
            return 1
        fi
        rm -f "$review_lock/pid"
        rmdir "$review_lock" 2>/dev/null || true
        mkdir "$review_lock" 2>/dev/null || {
            printf '%s\n' "Push rejected: could not acquire the project source review lock." >&2
            return 1
        }
    fi
    printf '%s\n' "$$" > "$review_lock/pid"
    trap 'rm -f "$review_lock/pid"; rmdir "$review_lock" 2>/dev/null || true' EXIT

    printf '%s\n' "Running source review before push..." >&2
    review_status=0
    review_filter='**/*.c,**/*.C,**/*.h,**/*.H,**/*.py,**/*.PY,**/*.asm,**/*.ASM,**/*.s,**/*.S,**/*.z80,**/*.Z80'
    review_log=$(git rev-parse --git-path wzsn-source-review.log)
    review_started=$(date +%s)
    if [ "$gito_runner" = "gito" ]; then
        "$review_timeout" --signal=TERM --kill-after=10s 1200s \
            gito --verbose review --against="$oldrev" --filter="$review_filter" \
            >"$review_log" 2>&1 || review_status=$?
    elif [ "$gito_runner" = "py -m gito" ]; then
        "$review_timeout" --signal=TERM --kill-after=10s 1200s \
            py -m gito --verbose review --against="$oldrev" --filter="$review_filter" \
            >"$review_log" 2>&1 || review_status=$?
    else
        "$review_timeout" --signal=TERM --kill-after=10s 1200s \
            python -m gito --verbose review --against="$oldrev" --filter="$review_filter" \
            >"$review_log" 2>&1 || review_status=$?
    fi
    review_elapsed=$(($(date +%s) - review_started))
    cat "$review_log" >&2
    if [ "$review_status" -eq 124 ] && [ "$review_elapsed" -ge 1200 ]; then
        stall_log=$(git rev-parse --git-path wzsn-source-review-stall.log)
        printf 'STALL elapsed=%ss limit=1200s diagnostics=%s\n' \
            "$review_elapsed" "$review_log" | tee -a "$stall_log" >&2
    fi
    rm -f "$review_lock/pid"
    rmdir "$review_lock" 2>/dev/null || true
    trap - EXIT
    return "$review_status"
}

check_range() {
    oldrev=$1
    newrev=$2

    if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
        return 0
    fi

    if [ "$oldrev" = "0000000000000000000000000000000000000000" ]; then
        range=$newrev
    else
        range="$oldrev..$newrev"
    fi

    if matches=$(git log --format='commit %H%nAuthor: %an <%ae>%nCommitter: %cn <%ce>%n%B' "$range" | grep -n -i -E "$BANNED"); then
        printf '%s\n' "Push rejected: banned word or phrase found in commit metadata or messages:" >&2
        printf '%s\n' "$matches" >&2
        return 1
    fi
}

failed=0
bash .githooks/validate-test-ledger.sh || failed=1
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    if [ "$local_ref" != "refs/heads/main" ] || [ "$remote_ref" != "refs/heads/main" ]; then
        printf '%s\n' "Push rejected: this project accepts direct branch pushes to main only." >&2
        failed=1
    fi
    check_pathnames "$local_sha" || failed=1
    check_banned_content "$remote_sha" "$local_sha" || failed=1
    check_license_headers "$remote_sha" "$local_sha" || failed=1
    check_range "$remote_sha" "$local_sha" || failed=1
    if [ "$failed" -eq 0 ]; then
        review_outgoing_source "$remote_sha" "$local_sha" || failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi

# Preserve Git LFS enforcement already used by this repository.
if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@"
else
    printf '%s\n' "Push rejected: Git LFS is required but 'git-lfs' was not found on PATH." >&2
    exit 2
fi
